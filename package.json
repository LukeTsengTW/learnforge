{
  "name": "learnforge",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:ai-context && tsc -b && vite build",
    "lint": "oxlint && eslint . --max-warnings 0",
    "test": "npm run check:ai-context && vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "generate:ai-context": "node scripts/generate-ai-quiz-context.mjs",
    "check:ai-context": "node scripts/generate-ai-quiz-context.mjs --check"
  },
  "engines": {
    "node": "24.21.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.1",
    "katex": "^0.16.47",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "supabase": "2.117.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
